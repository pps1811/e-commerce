# PostgreSQL connection string (Neon, Supabase, or local Postgres)
# Get this from your Neon project dashboard: https://console.neon.tech
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Public site URL, used for sitemap.xml, canonical URLs, and Open Graph tags
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Auth.js
AUTH_SECRET="" # generate with: npx auth secret
# Google sign-in is disabled for now (no provider wired up in src/lib/auth.ts).
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# Razorpay
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET="" # set when configuring the webhook in the Razorpay dashboard

# Product image uploads (Vercel Blob). Created automatically when you add a
# Blob store in Vercel -> Storage. Leave empty locally to use plain image URLs.
BLOB_READ_WRITE_TOKEN=""

# Resend
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Aurelle <onboarding@resend.dev>" # replace with your verified sending domain
